                    android:startY="64"
                    android:endX="73"
                    android:endY="64"
                    android:type="linear">
                    <item android:offset="0.0" android:color="#B8860B" />
                    <item android:offset="0.5" android:color="#FFF3B0" />
                    <item android:offset="1.0" android:color="#9A6F18" />
                </gradient>
            </aapt:attr>
