                    android:centerY="48"
                    android:gradientRadius="32"
                    android:type="radial">
                    <item android:offset="0.0" android:color="#117A63" />
                    <item android:offset="0.62" android:color="#084C3D" />
                    <item android:offset="1.0" android:color="#03261E" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Open Book of Knowledge -->
        <path android:pathData="M54,59.5 C47.5,56.2 40.5,55.8 35.2,57.5 L36.4,70.2 C41.6,68.8 48.0,69.4 54,72.8 C60.0,69.4 66.4,68.8 71.6,70.2 L72.8,57.5 C67.5,55.8 60.5,56.2 54,59.5 Z">
