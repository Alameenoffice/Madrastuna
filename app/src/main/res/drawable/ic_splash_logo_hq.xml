        <path
            android:fillColor="#FFFFFF"
            android:pathData="M53.5,57.2 C48.0,53.6 41.6,53.0 36.8,54.4 L37.6,66.2 C42.4,64.8 48.2,65.4 53.5,68.8 Z" />
