        <!-- Inner Royal Emerald Shield Core -->
        <path android:pathData="M54,26.2 L76.5,33.0 L76.5,51.8 C76.5,65.6 66.5,75.2 54,81.0 C41.5,75.2 31.5,65.6 31.5,51.8 L31.5,33.0 Z">
