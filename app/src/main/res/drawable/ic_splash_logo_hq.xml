    android:viewportHeight="288">

    <!--
        Ultra-crisp Vector Splash Logo for Android 12+ SplashScreen API
        Canvas: 288dp x 288dp | Safe Zone Circle: diameter 168dp (radius 84dp, centered at 144,144)
        Entire Royal Academic Medallion sits strictly within radius 76dp (152dp diameter) for zero clipping.
    -->

    <!-- Deep Royal Emerald Circular Medallion (r = 76dp, strictly inside 84dp safe radius) -->
    <path android:pathData="M144,68 A76,76 0 1,1 143.99,68 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="144"
                android:centerY="132"
                android:gradientRadius="84"
                android:type="radial">
                <item android:offset="0.0" android:color="#117A63" />
                <item android:offset="0.58" android:color="#084C3D" />
                <item android:offset="1.0" android:color="#03221B" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Subtle Golden Medallion Border Ring -->
    <path
        android:fillColor="#00000000"
        android:pathData="M144,71 A73,73 0 1,1 143.99,71 Z"
        android:strokeColor="#D4AF37"
        android:strokeWidth="2.2" />

    <!-- Inner Soft Highlight Halo -->
    <path
        android:fillColor="#00000000"
        android:pathData="M144,75 A69,69 0 1,1 143.99,75 Z"
        android:strokeColor="#44FFF3B0"
        android:strokeWidth="1.0" />

    <!-- Centered Royal Academic Crest scaled 1.65x from 108x108 coordinate space -->
