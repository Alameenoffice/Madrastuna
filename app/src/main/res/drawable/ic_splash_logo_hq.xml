        <path android:pathData="M54,22 L81,30.2 L81,52.5 C81,68.8 69.2,79.8 54,86 C38.8,79.8 27,68.8 27,52.5 L27,30.2 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:startX="27"
                    android:startY="22"
                    android:endX="81"
                    android:endY="86"
                    android:type="linear">
                    <item android:offset="0.0" android:color="#FFF3B0" />
                    <item android:offset="0.32" android:color="#F4D068" />
                    <item android:offset="0.65" android:color="#D4AF37" />
                    <item android:offset="1.0" android:color="#9A6F18" />
